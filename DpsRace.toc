## Interface: 120105
## Title: Ka0s DPS Race
## Notes: A timed DPS race against training dummies, with a live HUD, a run history and personal bests.
## Author: add1kted2ka0s
## Version: 0.1.0
## IconTexture: Interface\AddOns\DpsRace\media\logos\dpsrace.logo.128.tga
## SavedVariables: DpsRaceDB, DpsRacePerfDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0
## DefaultState: enabled
## Category-enUS: Combat
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
# X-Curse-Project-ID: not published on CurseForge yet

# Libraries (must load first) -- vendored in libs/, .xml where the lib ships one, else .lua
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.lua
libs\AceAddon-3.0\AceAddon-3.0.lua
libs\AceEvent-3.0\AceEvent-3.0.lua
libs\AceTimer-3.0\AceTimer-3.0.lua
libs\AceDB-3.0\AceDB-3.0.lua
libs\AceDBOptions-3.0\AceDBOptions-3.0.lua
libs\AceConsole-3.0\AceConsole-3.0.lua
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\AceConfig-3.0\AceConfig-3.0.xml
# ONE line: the .xml is itself the file list (library-stack-§7). After Ace3.
libs\LibKa0s\LibKa0s.xml
libs\LibSharedMedia-3.0\lib.xml
libs\AceGUI-3.0-SharedMediaWidgets\widget.xml
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\lib.xml

# Locales
# LOAD-BEARING: creates NS.L, which core\LauncherSetup.lua and every settings\ file read at FILE SCOPE.
locales\enUS.lua

# Core -- dependency-correct order (layout-§1). Every LOAD-BEARING note says what resolves at load;
# core\State.lua, core\Bus.lua, core\PoolSetup.lua and core\Database.lua are conventional and may
# move within the group (nothing else in core\ reads them at FILE SCOPE).
# LOAD-BEARING: publishes NS.PREFIX, NS.name, NS.BRAND and the version fallback every file below reads.
core\Namespace.lua
# LOAD-BEARING: publishes NS.MediaFont, which core\Constants.lua resolves FONT_MONO from at FILE SCOPE.
core\MediaSetup.lua
core\Constants.lua
core\State.lua
# LOAD-BEARING: resolves NS.version at FILE SCOPE (needs core\Namespace.lua's fallback), and
# core\PerfSetup.lua calls NS.Version() at FILE SCOPE, so this precedes it.
core\EnvSetup.lua
# LOAD-BEARING: after NS.PREFIX, before anything that prints; publishes NS.Util.print, which
# core\DpsRace.lua reclaims at FILE SCOPE, and NS.LIBKA0S_MISSING, which the stubs below read.
core\CoreSetup.lua
# LOAD-BEARING: the compat family's root (compat). Resolves LibKa0s-Compat-1.0 at FILE SCOPE and
# publishes NS.Compat, whose guards core\Secrets.lua binds at FILE SCOPE; modules read it at CALL time.
core\Compat.lua
# LOAD-BEARING: after core\Compat.lua (binds its guards at FILE SCOPE); publishes NS.Secrets, which
# modules\Meter.lua captures at FILE SCOPE, so it sits before the modules.
core\Secrets.lua
core\Bus.lua
core\PoolSetup.lua
# Reads LibStub (LibKa0s-Widgets-1.0) at FILE SCOPE and NS.Icon at CALL time only.
core\WidgetsSetup.lua
# LOAD-BEARING: core\PerfSetup.lua hands NS.lifecycle to LibKa0s-Perf-1.0, which RAISES at :New
# without it, so the latch is built first.
core\LifecycleSetup.lua
# LOAD-BEARING: before any module taking NS.Perf as a load-time upvalue.
core\PerfSetup.lua
# LOAD-BEARING: after core\Constants.lua (FONT_MONO), core\State.lua (the flag) and core\CoreSetup.lua
# (the printer), before any NS.Debug call.
core\DebugLogSetup.lua
# LOAD-BEARING: reads NS.Constants.LOGO_128 and NS.L at FILE SCOPE (the library raises on a launcher
# with no icon). Everything else it names is resolved at CALL time.
core\LauncherSetup.lua
# LOAD-BEARING: promotes NS to the AceAddon object and reclaims NS.Print from NS.Util.print at FILE
# SCOPE, so it follows core\CoreSetup.lua.
core\DpsRace.lua
core\Database.lua

# Defaults (the only place a default is hardcoded -- savedvariables-§2)
defaults\Profile.lua
# LOAD-BEARING: publishes NS.Dummies and reads NS.L at FILE SCOPE (the category labels); calls
# NS.Secrets at CALL time only.
defaults\Dummies.lua

# Modules -- conventional order: each reaches the others at CALL time, except as noted.
# LOAD-BEARING: publishes NS.Meter and resolves the meter enums at FILE SCOPE; first, so every later
# module may capture it.
modules\Meter.lua
modules\Recorder.lua
# The loadout store (#6): reached by Recorder and Race at CALL time.
modules\Loadouts.lua
modules\Timeline.lua
modules\Scoring.lua
# LOAD-BEARING: builds its bus receiver (RUN_SAVED / RUNS_CHANGED) at FILE SCOPE through core\Bus.lua.
modules\Bests.lua
# The damage chart's in-session store (#2): one opaque live total per bucket, by run id, never saved.
modules\Slices.lua
# The race's cast list (#14) and what was used (#13): reached by Watchers, Race and MockRuns at CALL time.
modules\Casts.lua
modules\Usage.lua
modules\Race.lua
modules\Watchers.lua
# The Race HUD (T7). Format first: the HUD's files reach it at call time, as they reach each other.
modules\Format.lua
# LOAD-BEARING: the shared look. The HUD's and the Results window's files capture NS.Style at FILE SCOPE.
modules\Style.lua
# The HUD's configured look (HUD > HUD Appearance). LOAD-BEARING: reads NS.defaults (defaults\Profile.lua)
# at FILE SCOPE; the HUD's and the Results window's files reach it at CALL time.
modules\Hud_Appearance.lua
modules\Hud_Breakdown.lua
# The damage chart and the pace bar (#2, #3). LOAD-BEARING: reads NS.defaults (defaults\Profile.lua)
# and captures NS.Style at FILE SCOPE, and modules\Hud.lua reads its PACE_H at FILE SCOPE (through
# NS.HudStates.MinContentHeight()); modules\Hud_States.lua and modules\Results_Detail.lua build it at
# CALL time.
modules\Hud_Chart.lua
modules\Hud_States.lua
# LOAD-BEARING: builds its bus receiver (RACE_STATE_CHANGED / RACE_BUZZER / RACE_RESULT) at FILE SCOPE
# through core\Bus.lua, reads NS.defaults (defaults\Profile.lua) for its default size, and calls
# NS.HudStates.MinContentHeight() (modules\Hud_States.lua, which reaches modules\Hud_Breakdown.lua) for
# its minimum height.
modules\Hud.lua
# The race's final seconds: the countdown cue and the center-screen numbers, its own frame. LOAD-BEARING:
# builds its bus receiver (RACE_STATE_CHANGED) at FILE SCOPE through core\Bus.lua.
modules\Countdown.lua
# The Results window (T8). The table first: the tabs and the detail capture NS.ResultsTable at FILE
# SCOPE, so each follows the files it captures (the row pitch is read at CALL time).
# Where the window reads its runs: the store, or the sample history while test mode or a sim is on
# (B5). Reached at CALL time only.
modules\Results_Source.lua
modules\Results_Table.lua
# What the tables say on hover (every cell, every header); reached at CALL time.
modules\Results_Tips.lua
modules\Results_Runs.lua
modules\Results_Detail.lua
# The detail's compare (#7): captures NS.ResultsDetail at FILE SCOPE (its CompareSpells), so it
# follows it; the detail builds its parts at CALL time.
modules\Results_Compare.lua
# The detail's gear and talents (#6); the detail builds, fills and lays it out at CALL time.
modules\Results_Loadout.lua
# The detail's usage (#13) and the Runs list's Used column: captures NS.ResultsTable and NS.Style at
# file scope; the detail builds it and Results_Runs reaches it at call time.
modules\Results_Usage.lua
modules\Results_Bests.lua
# LOAD-BEARING: builds its bus receiver (RUN_SAVED / RUNS_CHANGED / SETTINGS_CHANGED) at FILE SCOPE
# through core\Bus.lua, and reads NS.defaults (defaults\Profile.lua) for its default size.
modules\Results.lua
# Share (T9): the one-line share and the race's own chat lines. LOAD-BEARING: builds its bus receiver
# (RACE_STATE_CHANGED / RACE_RESULT) at FILE SCOPE through core\Bus.lua.
modules\Share.lua
# The sample data test mode and the sim draw (B5): a made-up run history and HUD race, never stored.
# Reached at CALL time only.
modules\MockRuns.lua
# Test mode and the sim's shell (T9, B5). LOAD-BEARING: builds its bus receiver (RACE_STATE_CHANGED)
# at FILE SCOPE through core\Bus.lua; drives the HUD (modules\Hud.lua) and the Results window's source
# (modules\Results_Source.lua) at CALL time.
modules\Preview.lua
# `/dr sim`'s scenarios and script (B5). LOAD-BEARING: captures NS.MockRuns at FILE SCOPE, so it
# follows modules\MockRuns.lua.
modules\Sim.lua
modules\Diagnostics.lua

# Settings (last -- depend on everything else being initialized)
# LOAD-BEARING: publishes NS.RegisterSchemaRows, which settings\General.lua calls at FILE SCOPE.
settings\Schema.lua
settings\Slash.lua
# LOAD-BEARING: publishes NS.Helpers, which every page file below captures at FILE SCOPE, and
# NS.RegisterTabbedPage, which settings\Race.lua, Hud.lua and History.lua call at FILE SCOPE.
settings\OptionsSetup.lua
# LOAD-BEARING: General registers FIRST and Profiles LAST -- the page order IS the registration order.
settings\General.lua
# The Race, HUD and History pages (T9), in the panel's order (General, Race, HUD, History, Profiles).
# History builds its bus receiver (RUNS_CHANGED / RUN_SAVED) at FILE SCOPE through core\Bus.lua; Race
# reads NS.HudStates.PRESETS and NS.Format at FILE SCOPE (modules\Hud_States.lua, modules\Format.lua
# above); HUD reads NS.defaults at FILE SCOPE.
settings\Race.lua
settings\Hud.lua
settings\History.lua
settings\Profiles.lua
